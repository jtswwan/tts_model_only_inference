# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 模型權重（體積過大，另行下載）
*.pth
*.ckpt
*.bin
*.onnx
*.safetensors
*.pt

# 輸出
output/
*.wav
!docs/**/*.wav

# 工具
.DS_Store
.idea/
.vscode/

# 測試產生的暫存
hdr*.txt
samples/

# 教育部辭典（14 MB，由 scripts/tw_check.py --download 取得）
# 原封不動保存，授權見 moedict/來源與授權.md
moedict/*.xz
.moedict-cache.json

# 展示用的離線控制台（由 scratchpad 的 build_demo.py 產生）
demo_console.html

# 備份檔（scripts/backup.py 產生）與還原時留下的副本
gsv-backup-*.tar.gz
*.bak

# nltk 語料（約 20 MB，由 scripts/fetch_models.sh 下載）
nltk_data
nltk_data/

# 本機虛擬環境（start.py 建在這裡）
# 不帶斜線：帶斜線只匹配目錄，而它也可能是指向別處的 symlink
.venv
.venv/
venv
venv/
